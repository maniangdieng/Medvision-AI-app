# ── Base de données PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://medvision:CHANGER_MOI@localhost:5432/medvision
DATABASE_SSL=false
# true au premier lancement (crée les tables), false ensuite en production
DB_SYNC=true

# ── Sécurité ────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_64_CARACTERES
# true dès que le site est servi en HTTPS
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# ── Premier administrateur (utilisé par « npm run seed ») ───────────────
ADMIN_EMAIL=admin@medvision.sn
ADMIN_PASSWORD=ChangezMoi2026

# ── Service IA (Colab) ──────────────────────────────────────────────────
# URL affichée par la cellule 4 du notebook MedVision_Serveur_IA_Colab.ipynb
AI_SERVICE_URL=https://xxxx.trycloudflare.com
# Même valeur que le secret MEDVISION_API_KEY dans Colab
AI_API_KEY=REMPLACER_PAR_UNE_LONGUE_CLE_SECRETE
AI_TIMEOUT_MIN=10

# ── Fichiers ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
PORT=4000

# ── E-mails (Brevo) ─────────────────────────────────────────────────────
# Vide = le mot de passe provisoire s'affiche à l'administrateur
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=MedVision
APP_URL=
